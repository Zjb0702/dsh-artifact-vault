{
  "name": "dsh-artifact-vault",
  "version": "0.2.2",
  "type": "module",
  "description": "产物管家（Artifact Vault）：按产出这些文件的会话归属工作区文件，同名文件按版本分组并标注状态，通过同盘回收站与 C 盘清理计划管理磁盘占用。",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zjb0702/dsh-artifact-vault"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "artifact",
    "session",
    "versioning",
    "disk-usage",
    "recycle-bin"
  ],
  "license": "MIT",
  "icon": "icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/logic.mjs && node test/client-smoke.mjs && node test/host-smoke.mjs && node test/features-smoke.mjs"
  }
}
